module main -> sql;

ID:
    @ ([a-zA-Z_] [a-zA-Z0-9_]*)
    {@}
;
NUMBER:
    @ [0-9]+ ('.' @ [0-9]+)?
    @{main, decimal}
;
STRING:
    '\'' @ [^']* '\''
    {@}
;

sql: 
    @ select_stmt ';'?
;
select_stmt: 
    'SELECT' @ column 'FROM' @ ID @ where_clause? @ order_clause? 
    
    @{columns, table, where, order}
;
columns:
    @ column (',' @ column)*

    @{first, list}
;
column:
    @ expr ('as' @ ID)?
    
    @{expr, alias}
;

where_clause:
    'WHERE' @ expr
    {@}
;
condition:
    @ comparison (@ logical @ comparison)*

    @{comp_left, log, comp_right}
    #logical:
        @ 'AND' | 'OR'
        {@}
    ;
;

comparison:
    @ expr (\s0 @ op \s0 @ expr)?
    @{left, oper, right}

    #op:
        @ '=' | '!=' | '<=' | '>=' | '<' | '>'
        {@}
    ;
;

expr:
    @ term (\s0 @ op \s0 @ term)*
    @{first, ops, rest}

    #op:
        @ '+' | '-'

        {@}
    ;
;

term:
    @ primary (\s0 @ op \s0 @ primary)*

    @{first, ops, rest}

    #op:
        @ '*' | '/'

        {@}
    ;
;

primary:
    @ NUMBER | STRING | ID | ('(' \s0 @ condition \s0 ')')
    {@}
;

order_clause:
    'ORDER' 'BY' @ ID @ direction?
    @{column, direct}

    #direction:
        @ 'ASC' | 'DESC'
        {@}
    ;
;