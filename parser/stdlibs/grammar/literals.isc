module std.literals;

SIMPLE_NUMBER:
    @ [0-9]+ ('.' @ % [0-9]+)?

    @{full, dec}
    %{no_precision_after_dot}
;
STRING<quote>:
    &q quote @ ( '\\' [*] | !($q | [^\n\r]) )* % $q
    {@}
    %{inclosed_quote}
;
fail SIMPLE_NUMBER.no_precision_after_dot {
    if ctx.at(','):
        ctx.error("There should not be comma after '.'")
        ctx.delete()
    elif ctx.at('.'):
        ctx.error("Dublicate dot")
        ctx.delete()
    else:
        ctx.error("Number floating-point part expected")
}

fail STRING.inclosed_quote {
    ctx.error("Incloded quote")
    ctx.insert()
}