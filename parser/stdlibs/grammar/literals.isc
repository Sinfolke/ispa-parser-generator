module std.literals;

SIMPLE_NUMBER:
    @ [0-9]+ ('.' @ % [0-9]+)?

    @{full, dec}
    %{no_prevision_after_dot}
;
#[inline]
STRING<quote>:
    &q quote @ ( '\\' @ [*] | !($q | [\n\r]) )* % $q
    {@}
    %{inclosed_quote}
;
#[inline]
ID:
    @ ([a-zA-Z_] [a-zA-Z0-9_]*)
    {@}
;

fail SIMPLE_NUMBER.no_prevision_after_dot {
    if ctx.at(','):
        ctx.error("There should not be comma after '.'")
        ctx.delete()
    elif ctx.at('.'):
        ctx.error("Dublicate dot")
        ctx.delete()
}
fail STRING.inclosed_quote {
    ctx.pos = ctx.start_pos
    while not ctx.at(' ') and not ctx.at('\t') and not ctx.at('\r'):
        ctx.pos += 1
    ctx.error("Incloded quote")
    ctx.insert()
}
