module std.numbers;
UNSIGNED: @ ([0-9]+) {@};
INTEGER: @ ((([0-9]+) | ([+-] [0-9]+))) {@};
HEX_INTEGER: @ ('0' [xX] [0-9a-fA-F]+) {@};
BINARY_INTEGER: @ ('0' [bB] [01]+) {@};
OCTAL_INTEGER: @ ('0' [oO] [0-7]+) {@};
DECIMAL: @ ((([0-9]+) | ([+-] [0-9]+)) ('.' [0-9]+)? ([eE] (([0-9]+) | ([+-] [0-9]+)))?) {@};
