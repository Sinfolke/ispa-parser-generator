module ispa_dep_scanner;
import {name, ID, NUMBER, template_params, rule_params, call_params} from common;
import * from scanner_tokens;
mod_module:
    @ 'module' @ module_path @ template_params? ('->' @ source_name)? @ ';'
    @{begin, name, parameters, entry, end}
;
mod_import:
    @ 'import' @ 'py'? @ external_import? @ import_value @ ';'
    @{begin, py_import, external, value, end}
    #external_import:
        'extern' @ ID
        {@}
    ;
    #import_value:
        @ module_import | from_import
        {@}
        #module_import:
            @ module_path ('as' @ ID)?
            @{source, alias}
        ;
        #from_import:
            @ selection 'from' @ module_path
            @{sel, source}
            #selection:
                @ '*' | items
                {@}
                #items:
                    '{' @ source_name (',' @ source_name)* '}'
                    @{first, sequence}
                ;
            ;
        ;
    ;
;
mod_detach:
    @ 'detach' @ detach_value @ ';'
    @{begin, value, end}
    #detach_value:
        @ feature_ref | source_name
        {@}
        #feature_ref:
            'feature' @ source_name
            {@}
        ;
    ;
;
feature_decl:
    @ 'feature' @ source_name '{' @ symbol_list? '}' @ ';'
    @{begin, name, symbols, end}
;
module_path:
    @ ID ('.' @ ID)*
    @{primary, nested}
;
// Keep common's name/parameter grammar, including for declaration headers.
source_name:
    @ name<rule_params>
    {@}
;
symbol_list:
    @ source_name (',' @ source_name)*
    @{first, following}
;
declaration:
    @ modifier* @ form
    @{modifiers, value}
    #form:
        @ name<rule_params> ('|' ID ('.' ID)*)? @ body
        @{name, body}
    ;
;
modifier: '#' CGROUP;
fail_decl: 'fail' source_name braces;
body:
    @ regular | braces
    {@}
    #regular:
        ':' @ member* ';'
        {@}
    ;
;
member:
    @ nested_rule | parentheses | braces | atom
    {@}
;
nested_rule:
    '#' @ declaration
    {@}
;
parentheses:
    ('(' | '&(' | '>(') balanced_item* ')'
;
braces: '{' balanced_item* '}';
balanced_item: parentheses | braces | atom | ';' | '#';
atom:
    ID | NUMBER | STRING | CGROUP | COMMENT | OTHER |
    '->' | ',' | '.' | '<' | '>' | ':' | '*' | '|'
;
