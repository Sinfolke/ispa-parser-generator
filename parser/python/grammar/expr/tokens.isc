module expr_tokens;

AMP: '&';
AMP_ASSIGN: '&=';
AND: 'and';
CARET: '^';
CARET_ASSIGN: '^=';
EQ: '==';
FALSE_BOOL: 'False';
FLOOR_DIV: '//';
FLOOR_DIV_ASSIGN: '//=';
GE: '>=';
GT: '>';
LBRACE {
    match '{';
    ctx.shared.bracket_depth: int
    ctx.shared.bracket_depth += 1
}
LBRACKET {
    match '[';
    ctx.shared.bracket_depth: int
    ctx.shared.bracket_depth += 1
}
LAMBDA: 'lambda';
LE: '<=';
LSHIFT: '<<';
LSHIFT_ASSIGN: '<<=';
LT: '<';
MINUS: '-';
MINUS_ASSIGN: '-=';
NE: '!=';
NONE_V: 'None';
NOT: 'not';
OR: 'or';
PERCENT: '%';
PERCENT_ASSIGN: '%=';
PIPE: '|';
PIPE_ASSIGN: '|=';
PLUS: '+';
PLUS_ASSIGN: '+=';
POWER: '**';
POWER_ASSIGN: '**=';
RBRACE {
    match '}';
    ctx.shared.bracket_depth: int
    if ctx.shared.bracket_depth > 0:
        ctx.shared.bracket_depth -= 1
}
RBRACKET {
    match ']';
    ctx.shared.bracket_depth: int
    if ctx.shared.bracket_depth > 0:
        ctx.shared.bracket_depth -= 1
}
RSHIFT: '>>';
RSHIFT_ASSIGN: '>>=';
SLASH: '/';
SLASH_ASSIGN: '/=';
STAR_ASSIGN: '*=';
TILDE: '~';
TRUE_BOOL: 'True';
