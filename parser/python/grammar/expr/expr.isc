module expr -> expr;
import * from tokens;
import * from expr_tokens;
import * from expr_valued_tokens;
expr:
    @ disjunction @ conditional_tail?
    @{value, conditional}
;

conditional_tail:
    IF @ %missing_operand disjunction %missing_else ELSE @ %missing_operand expr
    @{condition, otherwise}
;

disjunction:
    @ conjunction @ or_tail*
    @{first, rest}
;

or_tail:
    OR @ %missing_operand conjunction

    {@}
;

conjunction:
    @ inversion (AND @ %missing_operand inversion)*
    @{first, rest}
;
inversion:
    @ not_inversion | comparison
    {@}
;

not_inversion:
    NOT @ %missing_operand inversion
    {@}
;

comparison:
    @ bitwise_or @ compare_tail*
    @{first, rest}
;

compare_tail:
    @ compare_op @ %missing_operand bitwise_or
    @{op, value}
;

compare_op:
    @ EQ | NE | LE | LT | GE | GT | not_in | IN | is_op
    {@}
;
not_in:
    NOT IN
;

is_op:
    IS @ NOT?
    {@}
;
bitwise_or:
    @ bitwise_xor @ bitor_tail*
    @{first, rest}
;

bitor_tail:
    PIPE @ %missing_operand bitwise_xor

    {@}
;

bitwise_xor:
    @ bitwise_and @ bitxor_tail*
    @{first, rest}
;

bitxor_tail:
    CARET @ %missing_operand bitwise_and

    {@}
;

bitwise_and:
    @ shift_expr @ bitand_tail*
    @{first, rest}
;

bitand_tail:
    AMP @ %missing_operand shift_expr

    {@}
;

shift_expr:
    @ sum @ shift_tail*
    @{first, rest}
;

shift_tail:
    @ LSHIFT | RSHIFT @ %missing_operand sum
    @{op, value}
;

sum:
    @ term @ sum_tail*
    @{first, rest}
;

sum_tail:
    @ PLUS | MINUS @ %missing_operand term
    @{op, value}
;

term:
    @ factor @ term_tail*
    @{first, rest}
;

term_tail:
    @ FLOOR_DIV | STAR | SLASH | PERCENT | MATMUL @ %missing_operand factor
    @{op, value}
;

factor:
    @ unary_expr | power
    {@}
;

unary_expr:
    @ PLUS | MINUS | TILDE @ %missing_operand factor
    @{op, value}
;
power:
    @ primary @ power_tail?
    @{base, exponent}
;

power_tail:
    POWER @ %missing_operand factor

    {@}
;
primary:
    @ atom @ postfix*
    @{base, suffixes}
;

postfix:
    @ attribute_suffix | call_suffix | index_suffix
    {@}
;

attribute_suffix:
    DOT @ %missing_attribute ID

    {@}
;

call_suffix:
    LPAREN @ call_args? %missing_rparen RPAREN

    {@}
;

index_suffix:
    LBRACKET @ parenthesized_content %missing_rbracket RBRACKET

    {@}
;

atom:
    @ ID | NUMBER | STRING | TRUE_BOOL | FALSE_BOOL | NONE_V
 | parenthesized_expr | list_expr | dict_expr | lambda_expr
    {@}
;

// `lambda a, b: body` binds as far right as a conditional expression; the
// body is parsed here so it also works as a call argument.
lambda_expr:
    LAMBDA @ lambda_params? %missing_lambda_colon COLON @ %missing_operand expr
    @{params, body}
;

lambda_params:
    @ ID @ lambda_param_tail*
    @{first, rest}
;

lambda_param_tail:
    COMMA @ ID
    {@}
;

parenthesized_expr:
    LPAREN @ parenthesized_content? %missing_rparen RPAREN
    {@}
;

parenthesized_content:
    @ expr @ tuple_suffix?
    @{first, rest}
;

tuple_suffix:
    COMMA @ tuple_elements?
    {@}
;

tuple_elements:
    @ expr (COMMA @ expr)* COMMA?
    @{first, rest}
;
list_expr:
    LBRACKET @ expr_list? %missing_rbracket RBRACKET
    {@}
;

dict_expr:
    LBRACE @ dict_items? %missing_rbrace RBRACE
    {@}
;

expr_list:
    @ expr (COMMA @ expr)* COMMA?
    @{first, rest}
;

dict_items:
    @ dict_item @ dict_item_tail* COMMA?
    @{first, rest}
;

dict_item_tail:
    COMMA @ dict_item
    {@}
;

dict_item:
    @ expr %missing_colon COLON @ %missing_operand expr
    @{key, value}
;

call_args:
    @ call_arg @ call_arg_tail* COMMA?
    @{first, rest}
;

call_arg_tail:
    COMMA @ call_arg

    {@}
;

call_arg:
    @ keyword_arg | expr
    {@}
;

keyword_arg:
    @ ID ASSIGN @ %missing_operand expr
    @{name, value}
;
// Synchronize in token space so NEWLINE and synthetic DEDENT survive recovery.
fail missing_operand {
    ctx.error("Expected a Python expression")
    ctx.sync_tokens(COMMA, COLON, SEMICOLON, NEWLINE, DEDENT, RPAREN, RBRACKET, RBRACE)
    ctx.insert()
}
fail missing_attribute {
    ctx.error("Expected an attribute name after '.'")
    ctx.insert()
}
fail missing_rparen {
    ctx.error("Expected ')' to close Python expression")
    ctx.insert()
}
fail missing_rbracket {
    ctx.error("Expected ']' to close Python expression")
    ctx.insert()
}
fail missing_rbrace {
    ctx.error("Expected '}' to close Python expression")
    ctx.insert()
}
fail missing_colon {
    ctx.error("Expected ':' between dictionary key and value")
    ctx.insert()
}
fail missing_lambda_colon {
    ctx.error("Expected ':' after lambda parameters")
    ctx.insert()
}
fail missing_else {
    ctx.error("Expected 'else' in conditional expression")
    ctx.insert()
}
