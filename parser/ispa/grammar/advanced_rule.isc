module rule.advanced -> advanced_rule;

import {name, ID} from common;
import {stmt} from ispa_python;
import rule.regular;
advanced_rule:
    '{' @ (regular_match | stmt)* '}'

    @{body}
    #regular_match:
        'match' @ source? @ rule.regular.value+ @ unpack? ';'
        @{stream, patterns, assign_names}

        #source:
            '(' @ ID ')'
            {@}
        ;

        #unpack:
            '->' @ ID+

            {@}
        ;
    ;
    #fail_call:
        'fail' @ name

        {@}
    ;
;
