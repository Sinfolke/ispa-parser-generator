module grammar -> grammar;
import {name, rule_params} from common;
import rule.regular;
import rule.advanced;

grammar:
    @ modifier* @ name<rule_params> @ rule.regular | rule.advanced

    @{mod, name, entry}


;
modifier:
    '#[' @ MOD ']'

    {@}

    #MOD:
        @ 'inline' | 'noinline' | 'skip' | 'extern' | 'global'
        {@}
    ;
;