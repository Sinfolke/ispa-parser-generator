module common;

ID:
    @ ([a-zA-Z_] [a-zA-Z0-9_]*)
    {@}
;
NUMBER:
    @ [0-9]+ ('.' @ % [0-9]+)?

    @{full, floating}
    %{empty_after_dot}
;
name<params>:
    @ ID ('.' @ ID)* @ template_params? @ params?

    @{primary, nested, temp_params, param}
;
call_params:
    '&(' @ param? ')'
    {@}
;
rule_params:
    '(' @ param? ')'
    {@}
;
template_params:
    '<' @ template_param? '>'
    {@}
;
param:
    @ parameter (',' @ parameter)*
    @{first_p, following_p}
;
parameter:
    @ ID (':' @ type_annotation)?
    @{name, annotation}
;
type_annotation:
    @ ID ('.' @ ID)*
    @{base, nested}
;
template_param:
    @ ID (',' @ ID)*
    @{first_p, following_p}
;